# MySQL on your hosting (cPanel > MySQL Databases). URL-encode special characters in the password (@ -> %40)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Optional: protects the whole site with a password (browser login prompt, any username). Set this on Vercel!
# APP_PASSWORD="choose-a-long-password"

# Photo storage on cPanel: URL of the uploaded slm-photos.php and the secret written inside it
PHOTO_API_URL="https://YOURDOMAIN/slm-photos.php"
PHOTO_SECRET="long-random-secret"
